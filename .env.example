# Copia este archivo como ".env". Después de cambiarlo, reinicia Expo con: npx expo start -c

# URL del backend (Node + Express). En el celular usa la IP de tu compu, no localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Módulos que ya usan la API real, separados por coma. Los demás usan datos simulados.
# Claves: usuarios, tamagotchi, vestidor, misiones, tienda, animo  (o "todos")
# Vacío = toda la app con datos simulados.
EXPO_PUBLIC_API_MODULES=

# Usuario de prueba mientras no exista el inicio de sesión (M00)
EXPO_PUBLIC_DEV_USER_ID=u-1
