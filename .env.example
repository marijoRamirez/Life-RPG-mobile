# Copia este archivo como ".env". Después de cambiarlo, reinicia Expo con: npx expo start -c

# URL del backend (Node + Express). En el celular usa la IP de tu compu, no localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Módulos que ya usan la API real, separados por coma. Los demás usan datos simulados.
# Claves: usuarios, tamagotchi, vestidor, habitos, misiones, tienda, logros, animo  (o "todos")
# Vacío = toda la app con datos simulados.
EXPO_PUBLIC_API_MODULES=

# Usuario de prueba de los modos "mock" y "mock-login" (se envía como x-user-id)
EXPO_PUBLIC_DEV_USER_ID=u-1

# Inicio de sesión (M00):
#   mock       → sesión ya iniciada con el usuario de prueba (por defecto; la app abre en la Casa)
#   mock-login → empieza sin sesión para probar Login / Crear cuenta / Bienvenida sin Firebase
#                (cuenta de prueba: yess@liferpg.mx / Prueba123)
#   firebase   → Firebase Authentication real; llena las variables de abajo. La cuenta y la mascota
#                se guardan en el backend (que necesita FIREBASE_PROJECT_ID en su .env).
EXPO_PUBLIC_AUTH_MODE=mock

# Proyecto de Firebase (Consola de Firebase › Configuración del proyecto › Tus apps › App web).
# Pide los valores al equipo; no son secretos, pero no se suben al repo.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Authentication › Google › Configuración del SDK web › ID de cliente web
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
